{
  "name": "run-down",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:worker": "npm run dev --workspace=worker",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "vitest": "^2.1.8"
  }
}
