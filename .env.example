# ─── Server ─────────────────────────────────────────────
PORT=3001

# Max upload size in megabytes
MAX_FILE_SIZE_MB=2048

# How long to keep output files (hours)
RETENTION_HOURS=1

# Rate limiting: max uploads per window per IP
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000

# ─── Redis (BullMQ) ──────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=yourpassword   # uncomment if Redis has auth

# ─── Storage ─────────────────────────────────────────────
# Absolute paths to upload/output dirs (defaults to ./uploads and ./outputs inside server/)
# UPLOADS_DIR=/data/uploads
# OUTPUTS_DIR=/data/outputs

# ─── Worker ──────────────────────────────────────────────
# Max simultaneous ffmpeg processes
WORKER_CONCURRENCY=2

# Per-job ffmpeg timeout in seconds (default 30 min)
FFMPEG_TIMEOUT_SECONDS=1800

# ─── Database ────────────────────────────────────────────
# Path to SQLite file (defaults to ./data/rundown.db inside server/)
# DB_PATH=/data/rundown.db

# ─── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
